! name: News
! description: Boosts established news outlets with actual reporting over aggregators and SEO-optimized "news" rewrite sites.
! public: false
! author: Foggoblin

! ---------------------------------------------------------------------------
! Seeded from the "news" boost section of daily-driver.goggle, plus outlets
! added directly here. Not yet decided whether this should become a "closed"
! Goggle (leading generic $discard + explicit $boost allowlist -- see
! SYNTAX-NOTES.md) or split by topic (e.g. tech news vs. general news) --
! for now it's a general-purpose light nudge, open recall.
! ---------------------------------------------------------------------------

! --- Trusted outlets (boost) ------------------------------------------------
$boost=3,site=theguardian.com

! --- Wire-service / major outlets ------------------------------------------
$boost=6,site=cbc.ca
$boost=6,site=bbc.com
$boost=6,site=nytimes.com
$boost=6,site=aljazeera.com

! --- Canadian & international editorial/opinion outlets --------------------
$boost=5,site=theglobeandmail.com
$boost=5,site=macleans.ca
$boost=5,site=thewalrus.ca
$boost=5,site=thetyee.ca
$boost=5,site=thestar.com
$boost=5,site=economist.com

! --- Add more entries below as you identify them ---------------------------
